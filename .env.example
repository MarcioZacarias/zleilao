# ============================================
# ZConnect Leilão — variaveis de BOOT
# --------------------------------------------
# So' o que o processo precisa para subir. Toda configuracao operacional
# (LLM, intervalos, limites, textos) fica na tabela `system_settings`,
# editavel em /admin/settings. Ver SISTEMA.md.
# ============================================

POSTGRES_USER=zleilao
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=zleilao

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Admin inicial (criado no primeiro boot; troque a senha depois)
ADMIN_EMAIL=admin@zconnect.ia.br
ADMIN_PASSWORD=admin123

# Portas do override de desenvolvimento (ignoradas em producao)
DB_PORT=5434
BACKEND_PORT=8005
DASHBOARD_PORT=5177

# Desligue para rodar scripts/testes sem os jobs de fundo
SCHEDULER_ENABLED=true
